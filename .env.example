# =====================================================================================================================
# TravelOpt: variables de entorno
#
# Motor (engine/) y n8n: copiar este archivo a `.env` en la raíz.
# Web (web/):            copiar la sección "Web" a `web/.env.local` (Next.js lee ese archivo).
# Nunca commitear `.env` ni `web/.env.local` (ya están en .gitignore). Todos los valores de acá son de ejemplo.
#
# Generar secretos propios:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# =====================================================================================================================

# ---------------- Motor: obligatorias ----------------
ENV=local                            # local | staging | production. Sin ENV explícito el motor asume production (falla cerrado)
ENGINE_API_KEY=generate_a_random_secret_of_24_plus_chars   # secreto compartido entre la web y el motor (mín. 24 caracteres)
ENGINE_BASE_URL=http://localhost:8000
# Postgres local de `npx supabase start` (credenciales de demo que trae la CLI, solo para 127.0.0.1).
# En producción: Supabase → Project Settings → Database → Connection string → "Session pooler", con ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DEFAULT_MODE=fixture                 # fixture (datos de prueba, sin claves) | hybrid (precios reales con SerpApi) | live
ORCHESTRATOR=inprocess               # inprocess (sin n8n, más simple) | n8n (flujo visual; requiere la sección n8n)

# ---------------- Motor: proveedores opcionales (sin clave, el modo fixture funciona igual) ----------------
SERPAPI_API_KEY=your_serpapi_key_here          # https://serpapi.com/manage-api-key — Google Flights y Hotels (plan gratuito: 250/mes)
TICKETMASTER_API_KEY=your_ticketmaster_key_here  # https://developer.ticketmaster.com — Discovery API, gratis (5.000 pedidos/día)
OPENWEATHER_API_KEY=                           # https://openweathermap.org/api — pronóstico a 7 días (sin clave: promedio histórico de Open-Meteo)
ALERT_WEBHOOK_URL=                             # SECRETO: webhook de Discord, Slack o Telegram para alertas operativas (máx. 1 por tipo cada 15 min)

# ---------------- Motor: cuotas y límites (valores por defecto razonables) ----------------
MAX_FLIGHT_QUERIES_PER_RUN=12        # tope de búsquedas de vuelos por corrida
MAX_LODGING_QUERIES_PER_RUN=8        # tope de búsquedas de alojamiento por corrida (misma cuota)
MAX_SERPAPI_QUERIES_PER_RUN=6        # presupuesto de búsquedas pagas por corrida (lo cacheado no cuenta)
SERPAPI_QUOTA_RESERVE=20             # búsquedas que se protegen; al llegar, modo histórico (último precio real guardado)
PREFETCH_EVENT_CITIES=ORL:Orlando,NYC:New York  # ciudades del cron semanal de eventos

# ---------------- Web (copiar a web/.env.local) ----------------
# URL y publishable key de Supabase: `npx supabase status` en local; en producción Supabase → Project Settings → API.
# La publishable key es pública por diseño (la protege RLS). NUNCA poner una clave secreta en una variable NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
ENGINE_BASE_URL=http://localhost:8000
ENGINE_API_KEY=same_value_as_the_engine_ENGINE_API_KEY
# Cloudflare Turnstile (CAPTCHA del alta anónima). En desarrollo se puede omitir: se usa la clave de prueba pública de
# Cloudflare. En producción: Cloudflare → Turnstile → Add site, y el secreto va en Supabase → Authentication → Bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Panel de cuota (solo local): NEXT_PUBLIC_ADMIN_MODE lo muestra y ADMIN_MODE (solo servidor) habilita su ruta.
# ADMIN_MODE=true
# NEXT_PUBLIC_ADMIN_MODE=true

# ---------------- n8n (solo con ORCHESTRATOR=n8n) ----------------
N8N_VERSION=                         # versión exacta de la imagen (p. ej. 1.x.y); nunca latest
N8N_ENCRYPTION_KEY=generate_a_random_secret   # respaldarla: sin ella las credenciales guardadas en n8n son irrecuperables
N8N_TIMEZONE=UTC
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/plan-trip
N8N_WEBHOOK_SECRET=generate_a_random_secret
N8N_API_KEY=                         # n8n → Settings → n8n API (lo usa la herramienta de pruebas tools/devtools_mcp)
