    "ActivityOffer": {
      "properties": {
        "kind": {
          "const": "activity",
          "default": "activity",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "city": {
          "title": "City",
          "type": "string"
        },
        "activity_key": {
          "title": "Activity Key",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "price_per_pax_minor": {
          "minimum": 0,
          "title": "Price Per Pax Minor",
          "type": "integer"
        },
        "outdoor": {
          "title": "Outdoor",
          "type": "boolean"
        },
        "slots": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Slots",
          "type": "integer"
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "deeplink": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deeplink"
        }
      },
      "required": [
        "id",
        "provider",
        "city",
        "activity_key",
        "name",
        "date",
        "price_per_pax_minor",
        "outdoor"
      ],
      "title": "ActivityOffer",
      "type": "object"
