{
  "enabledMcpjsonServers": ["travelopt-devtools", "supabase-local"],
  "permissions": {
    "allow": [
      "mcp__travelopt-devtools",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run python -m app.cli:*)",
      "Bash(uv run python scripts/gate.py:*)",
      "Bash(npx supabase status:*)",
      "Bash(npx supabase test db:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ],
    "ask": [
      "mcp__supabase-local",
      "Bash(npx supabase db reset:*)",
      "Bash(npx supabase db push:*)",
      "Bash(npx supabase link:*)",
      "Bash(vercel:*)",
      "Bash(git push:*)",
      "Edit(.claude/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./engine/.env)",
      "Read(./web/.env.local)",
      "Read(./web/.env.production*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(supabase/.temp/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.development)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(supabase/.temp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-read.mjs\"",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Revisando acceso a .env"
          }
        ]
      }
    ]
  }
}
